          "name": "Toast Get Menu Last Modified Timestamp",
          "request": {
            "name": "Toast Get Menu Last Modified Timestamp",
            "description": {
              "content": "A lightweight endpoint that allows you to determine if a restaurant's menu data has been updated. Toast support strongly recommends that you do not make a call to the `/menus` endpoint unless the date and time returned by the `/metadata` endpoint is more recent than the `lastUpdated` date and time. While this recommendation applies to all clients of the menus API, it is particularly important for clients that have limited bandwidth.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metadata"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
